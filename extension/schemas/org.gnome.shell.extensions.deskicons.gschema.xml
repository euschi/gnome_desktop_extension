<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="deskicons">
  <schema id="org.gnome.shell.extensions.deskicons" path="/org/gnome/shell/extensions/deskicons/">

    <!-- Appearance -->
    <key name="icon-size" type="i">
      <range min="32" max="128"/>
      <default>64</default>
      <summary>Icon size (px)</summary>
    </key>
    <key name="label-lines" type="i">
      <range min="1" max="4"/>
      <default>2</default>
      <summary>Maximum label lines</summary>
    </key>
    <key name="label-style" type="s">
      <choices>
        <choice value="shadow"/>
        <choice value="background"/>
        <choice value="none"/>
      </choices>
      <default>'shadow'</default>
      <summary>Label style</summary>
    </key>
    <key name="item-spacing" type="i">
      <range min="0" max="48"/>
      <default>8</default>
      <summary>Spacing between icons (px)</summary>
    </key>
    <key name="show-thumbnails" type="b">
      <default>true</default>
      <summary>Show file thumbnails</summary>
    </key>

    <!-- Layout -->
    <key name="start-corner" type="s">
      <choices>
        <choice value="top-left"/>
        <choice value="top-right"/>
        <choice value="bottom-left"/>
        <choice value="bottom-right"/>
      </choices>
      <default>'top-left'</default>
      <summary>Corner from which new icons are placed</summary>
    </key>
    <key name="fill-direction" type="s">
      <choices>
        <choice value="columns"/>
        <choice value="rows"/>
      </choices>
      <default>'columns'</default>
      <summary>Fill direction (columns or rows first)</summary>
    </key>
    <key name="margin-top" type="i">
      <range min="0" max="400"/>
      <default>12</default>
      <summary>Top margin</summary>
    </key>
    <key name="margin-bottom" type="i">
      <range min="0" max="400"/>
      <default>12</default>
      <summary>Bottom margin</summary>
    </key>
    <key name="margin-left" type="i">
      <range min="0" max="400"/>
      <default>12</default>
      <summary>Left margin</summary>
    </key>
    <key name="margin-right" type="i">
      <range min="0" max="400"/>
      <default>12</default>
      <summary>Right margin</summary>
    </key>
    <key name="snap-to-grid" type="b">
      <default>true</default>
      <summary>Align icons to the grid</summary>
    </key>
    <key name="keep-arranged" type="b">
      <default>false</default>
      <summary>Keep icons arranged</summary>
    </key>
    <key name="sort-by" type="s">
      <choices>
        <choice value="name"/>
        <choice value="modified"/>
        <choice value="type"/>
        <choice value="size"/>
      </choices>
      <default>'name'</default>
      <summary>Sort criterion</summary>
    </key>
    <key name="sort-reverse" type="b">
      <default>false</default>
      <summary>Reverse order</summary>
    </key>
    <key name="folders-first" type="b">
      <default>true</default>
      <summary>Folders before files</summary>
    </key>
    <key name="monitors" type="s">
      <choices>
        <choice value="all"/>
        <choice value="primary"/>
      </choices>
      <default>'all'</default>
      <summary>Monitors on which to show icons</summary>
    </key>

    <!-- Behavior -->
    <key name="icons-visible" type="b">
      <default>true</default>
      <summary>Icons visible</summary>
    </key>
    <key name="click-policy" type="s">
      <choices>
        <choice value="double"/>
        <choice value="single"/>
      </choices>
      <default>'double'</default>
      <summary>Click to open</summary>
    </key>
    <key name="launcher-policy" type="s">
      <choices>
        <choice value="ask"/>
        <choice value="always"/>
      </choices>
      <default>'ask'</default>
      <summary>Launching untrusted .desktop launchers</summary>
    </key>
    <key name="confirm-trash" type="b">
      <default>false</default>
      <summary>Ask for confirmation before moving to trash</summary>
    </key>
    <key name="terminal" type="s">
      <default>''</default>
      <summary>Terminal command (empty = automatic)</summary>
    </key>
    <key name="show-indicator" type="b">
      <default>true</default>
      <summary>Show panel indicator</summary>
    </key>

    <!-- Items -->
    <key name="show-home" type="b">
      <default>false</default>
      <summary>Show the Home folder</summary>
    </key>
    <key name="show-trash" type="b">
      <default>true</default>
      <summary>Show the Trash</summary>
    </key>
    <key name="show-volumes" type="b">
      <default>true</default>
      <summary>Show mounted drives</summary>
    </key>
    <key name="show-network-volumes" type="b">
      <default>false</default>
      <summary>Show network drives</summary>
    </key>
    <key name="show-hidden" type="b">
      <default>false</default>
      <summary>Show hidden files</summary>
    </key>
  </schema>
</schemalist>
